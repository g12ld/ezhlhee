# Configure these values only in the Vercel staging and production environments.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Calendar / Google Meet booking integration.
# Keep real values only in Vercel environment variables. Never commit secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Smart Advisor — Gemini AI (server-side only). Leave empty to use local heuristic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Booking rules. Timezone must remain Asia/Riyadh for the Saudi consultation flow.
BOOKING_TIMEZONE=Asia/Riyadh
BOOKING_DURATION_MINUTES=30
BOOKING_BUFFER_MINUTES=0
BOOKING_MIN_NOTICE_HOURS=4
BOOKING_MAX_DAYS_AHEAD=21
BOOKING_WORKING_DAYS=0,1,2,3,4,5,6
BOOKING_START_TIME=12:00
BOOKING_END_TIME=22:00
